DATABASE_URL=postgresql://cecebe:CHANGE_ME@localhost:5432/cecebe?schema=public
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
ENCRYPTION_KEY=replace-with-64-hex-characters
# Optional password recovery SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Only enable for a trusted private AI gateway (allows private IP addresses)
ALLOW_PRIVATE_AI=false

# Docker Compose database password; match DATABASE_URL for local development
POSTGRES_PASSWORD=CHANGE_ME
SITE_DOMAIN=example.com
TRUST_PROXY=false
# E2E: dedicated database, never use production database
TEST_DATABASE_URL=postgresql://cecebe:CHANGE_ME@localhost:5432/cecebe_test?schema=public
TEST_REDIS_URL=redis://localhost:6379/1
